# Google Sheets Service Account Configuration
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40project.iam.gserviceaccount.com

# Spreadsheet IDs
SPREADSHEET_PRODUCCION_CUNCIA=your-spreadsheet-id
SPREADSHEET_PRODUCCION_ACACIAS=your-spreadsheet-id
SPREADSHEET_MANTENIMIENTO_ACACIAS=your-spreadsheet-id
SPREADSHEET_MANTENIMIENTO_CUNCIA=your-spreadsheet-id
SPREADSHEET_ORDENES_OT_CUNCIA=your-spreadsheet-id
SPREADSHEET_ORDENES_OT_ACACIAS=your-spreadsheet-id
SPREADSHEET_MAESTRO_CUNCIA=your-spreadsheet-id
SPREADSHEET_MAESTRO_ACACIAS=your-spreadsheet-id
SPREADSHEET_PRODUCCION_CONCRETOS=your-spreadsheet-id
SPREADSHEET_ORDENES_OT_CONCRETOS=your-spreadsheet-id
SPREADSHEET_MAESTRO_CONCRETOS=your-spreadsheet-id

# Supabase Authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for admin operations - user delete, password reset, login_attempts)
# Obtener de: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
APP_ENV=production
APP_DEBUG=false
CACHE_TTL=300
